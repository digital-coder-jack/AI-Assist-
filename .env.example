# Wispbyte Discord bot
DISCORD_TOKEN=
FORGE_ASSIST_BACKEND_URL=https://your-project.vercel.app
FORGE_ASSIST_API_SECRET=replace-with-a-long-random-shared-secret
FORGE_ASSIST_CHANNEL_IDS=
FORGE_ASSIST_CONTEXT_LIMIT=12
FORGE_ASSIST_REQUEST_TIMEOUT_MS=25000

# Vercel backend / AI providers
CLAUDE_API_KEY=
KIMI_API_KEY=
GROQ_API_KEY=
FORGE_ASSIST_API_SECRET=replace-with-the-same-long-random-shared-secret
AI_PROVIDER_ORDER=claude,kimi,groq
AI_PROVIDER_TIMEOUT_MS=20000
CLAUDE_MODEL=claude-3-5-haiku-latest
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=moonshot-v1-8k
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Forge Data Center 2: S3-compatible persistent object storage (R2, S3, MinIO, etc.)
FORGE_ASSIST_S3_ENDPOINT=
FORGE_ASSIST_S3_REGION=auto
FORGE_ASSIST_S3_BUCKET=
FORGE_ASSIST_S3_ACCESS_KEY=
FORGE_ASSIST_S3_SECRET_KEY=
FORGE_ASSIST_S3_FORCE_PATH_STYLE=true
FORGE_ASSIST_S3_PUBLIC_BASE_URL=
FORGE_ASSIST_S3_DATA_KEY=forge-assist/data.json
FORGE_ASSIST_MAX_ATTACHMENT_BYTES=25000000

# Telegram administration webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789,987654321
# Optional separate API key for non-Telegram admin API callers
FORGE_ASSIST_ADMIN_API_KEY=
